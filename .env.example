# YourWriter — local environment variables
#
# Copy this file to .env and fill in the values.
# DO NOT commit .env (it's in .gitignore).

# Required: Anthropic API key for the agent layer
ANTHROPIC_API_KEY=sk-ant-...

# Local QA convenience: pre-fills the login form when QA-ing manually with Playwright
QA_MANUAL_EMAIL=you@example.com
QA_MANUAL_PASSWORD=changeme

# DATABASE_URL
# Local dev (docker compose): set in docker-compose.yml directly. You don't
# need to put it here. The compose file points the backend at the postgres
# service via:
#   DATABASE_URL=postgresql+asyncpg://yourwriter:yourwriter@db:5432/yourwriter
#
# Production (Railway): set as a Railway env var, NOT here.
#
# Tests: defaults to sqlite+aiosqlite (see backend/config.py). CI overrides
# explicitly via `DATABASE_URL=sqlite+aiosqlite:///./test.db`.
